# ============================================================
# Spotlight environment configuration
# Copy this file to `.env` and adjust the values as needed.
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_KEY=

# Database driver: `sqlite` (default) or `mysql`
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=spotlight
